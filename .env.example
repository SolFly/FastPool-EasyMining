# Docker Compose reads this file automatically.
# Native binary: ./bin/fastpool-easymining-linux-amd64 --env-file=.env
HOST=127.0.0.1
PORT=8080
DATA_DIR=./data
# Set the exact browser origin when using an HTTPS reverse proxy:
# PUBLIC_URL=https://easymining.example.com
# Optional initial password, 12+ characters. Prefer the one-time setup UI.
# APP_PASSWORD=
# Optional existing NiceHash credentials. Docker Compose passes these into the service.
# Alternatively configure credentials in the web UI; no credentials are included here.
NICEHASH_API_KEY=
NICEHASH_API_SECRET=
NICEHASH_ORGANIZATION_ID=
NICEHASH_BASE_URL=https://api2.nicehash.com
# Optional JSON file using the nicehash object and ${NICEHASH_...} placeholders:
# NICEHASH_CONFIG_FILE=./config.json
